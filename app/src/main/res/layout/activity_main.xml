<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐧 Linux on Android"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="48dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Linux distributions on your Android device"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/startSetupButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Setup New Linux"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/startSessionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue Session"
            android:textSize="16sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Settings"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="About"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
