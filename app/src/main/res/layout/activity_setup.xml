<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".setup.SetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure real Linux on Android with Embedded X11 display"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="28dp"/>

        <!-- Distro Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_distro"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/distroSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="20dp"/>

        <!-- Arch Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_arch"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/archRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/arm64Radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/arm64"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/x86_64Radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/x86_64"/>
        </RadioGroup>

        <!-- Desktop Environment -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_desktop"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/desktopSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="20dp"/>

        <!-- Display & Window Manager Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_mode_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/windowManagerRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/embeddedDisplayRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Embedded In-App Desktop (Recommended - No external apps)"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/turmuxX11Radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/turmux_x11_bootstrap"/>

            <RadioButton
                android:id="@+id/turmuxRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/turmux_bootstrap"/>

            <RadioButton
                android:id="@+id/noWMRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_window_manager"/>

        </RadioGroup>

        <!-- Browser Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_browser"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/browserSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="20dp"/>

        <!-- Status & Progress -->
        <ProgressBar
            android:id="@+id/setupProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Install Button -->
        <Button
            android:id="@+id/installButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Install &amp; Launch Linux"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>